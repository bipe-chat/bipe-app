    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- The PackageInstaller session status of AppUpdate. -->
        <receiver
            android:name="chat.bipe.app.update.AppUpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
