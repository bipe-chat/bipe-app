<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The owner check before approving a device, cancelling a recovery or replacing the recovery key. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".BipeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_launcher_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links (onboarding-welcome). Not verified: bipe.chat lists the fork's app only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bipe.chat" android:pathPrefix="/convite/" />
            </intent-filter>
            <!-- The link of the recovery e-mail (recovery-email, action openLink). The token sits in the fragment. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bipe.chat" android:path="/recuperar" />
                <data android:scheme="https" android:host="bipe.chat" android:path="/recuperar/" />
            </intent-filter>
        </activity>
    </application>

</manifest>
