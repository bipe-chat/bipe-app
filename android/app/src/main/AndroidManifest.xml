<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice messages (spec voice-recording). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Media viewer save on Android 8 and 9 (spec media-viewer). Android 10 and later need no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Spec contacts: the numbers leave the phone only for the lookup, and the server keeps none (ADR 0015). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Spec push-registration: the system permission for notifications (Android 13 and later). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Link a computer (spec link-computer-scan): the camera reads the QR code of chat.bipe.net.br. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- App lock, the owner checks of settings (spec app-lock, pin-change, data-export) and device approval (device-verification). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Calls (spec call, ADR 0186): audio routes, headsets, and the foreground service of a running call. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <application
        android:name=".BipeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_launcher_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Conferir no Bipe (specs pix-check-receive, pix-check-result): text and images only, never */*. -->
        <activity
            android:name=".pixcheck.PixCheckActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/bipe_pix_check_title"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links (onboarding-welcome). Not verified: bipe.chat lists the fork's app only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bipe.chat" android:pathPrefix="/convite/" />
            </intent-filter>
            <!-- Profile links bipe.chat/@handle (spec profile-link-open). The site serves the association file. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="bipe.chat" />
                <data android:host="www.bipe.chat" />
                <data android:pathPattern="/@.*" />
            </intent-filter>
            <!-- Recovery links from the recovery e-mail (recovery-email, action openLink). Not verified, like the invite links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bipe.chat" android:pathPrefix="/recuperar" />
            </intent-filter>
            <!-- Send to a chat (spec share-to-chat): text, links, photos, videos and files. -->
            <intent-filter android:label="@string/bipe_share_send_to_chat">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/bipe_share_send_to_chat">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Sharing shortcuts for the recent chats (spec share-to-chat). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- The end of a linked Apple or Google account web flow (ADR 0096): the Bipe API redirects the Custom Tab to
             <application id>:/link-done. LinkDoneActivity hands the URL over and closes the tab. The handoff works
             only with the flow ID this app keeps in memory. -->
        <activity
            android:name=".recovery.LinkDoneActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>
        <!-- Spec call: the call screen, and the service that keeps the call while the app is in the background. -->
        <activity
            android:name=".calls.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="chat.bipe.app.call"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <service
            android:name=".calls.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <!-- Spec notification-service: reply and mark as read from a notification. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />
        <!-- Shares the data export file (spec data-export). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
        <!-- Opens and shares decrypted media from the app cache (spec timeline-media, media-viewer). -->
        <provider
            android:name=".media.MediaFileProvider"
            android:authorities="${applicationId}.media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/media_paths" />
        </provider>
    </application>

</manifest>
