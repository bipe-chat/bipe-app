<!-- Sharing shortcuts of spec share-to-chat: ShareShortcuts pushes the recent chats with this category. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="chat.bipe.app.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="chat.bipe.app.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
