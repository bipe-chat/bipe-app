         </artifact>
      </component>
      <component group="chat.bipe.core" name="bipe-core-jvm" version="0.1.0">
         <artifact name="bipe-core-jvm-0.1.0.jar">
            <sha256 value="0a5a727b8b0d852c930de9de825dcd3ed600f489a66b4725230aaa1c6871bff4" origin="core/release/release.json"/>
         </artifact>
      </component>
